{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/public/ShasthoSathi-AI.apk",
      "destination": "/ShasthoSathi-AI.apk"
    },
    {
      "source": "/public/apk-parts/:path*",
      "destination": "/apk-parts/:path*"
    },
    {
      "source": "/public/app-icon.png",
      "destination": "/app-icon.png"
    },
    {
      "source": "/public/qr.js",
      "destination": "/qr.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ShasthoSathi-AI-v1.4.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/apk-parts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/apk-parts/(.*)\\.bin",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
