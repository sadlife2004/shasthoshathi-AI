{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user health profile, emergency contact, location, and language preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "displayName": {
          "type": "string",
          "description": "User full display name"
        },
        "age": {
          "type": "integer",
          "description": "User age in years"
        },
        "location": {
          "type": "string",
          "description": "User city or address location"
        },
        "emergencyNumber": {
          "type": "string",
          "description": "Emergency contact phone number"
        },
        "language": {
          "type": "string",
          "enum": ["EN", "BN"],
          "description": "Preferred UI and AI response language"
        },
        "healthConditions": {
          "type": "array",
          "description": "Selected health conditions such as Diabetes, High BP, Gastric"
        },
        "dietaryPreference": {
          "type": "string",
          "description": "Preferred diet style such as Regular, Low-Carb, Vegetarian, Budget-Friendly"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "displayName", "age", "language", "createdAt", "updatedAt"]
    },
    "MedicineReminder": {
      "title": "MedicineReminder",
      "description": "Scheduled medication dose reminder with custom clock time and alarm ringtone",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "medicineName": { "type": "string" },
        "dosage": { "type": "string" },
        "timeSlot": { "type": "string", "enum": ["MORNING", "NOON", "NIGHT"] },
        "scheduledTime": { "type": "string" },
        "mealTiming": { "type": "string", "enum": ["Before Meal", "After Meal", "Anytime"] },
        "durationDays": { "type": "integer" },
        "sourceType": { "type": "string", "enum": ["AUTO_RX", "MANUAL"] },
        "active": { "type": "boolean" },
        "todayStatus": { "type": "string", "enum": ["PENDING", "TAKEN", "SNOOZED", "SKIPPED"] },
        "lastActionDate": { "type": "string" },
        "notes": { "type": "string" },
        "ringtoneUri": { "type": "string" },
        "ringtoneName": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "medicineName",
        "dosage",
        "timeSlot",
        "scheduledTime",
        "mealTiming",
        "durationDays",
        "sourceType",
        "active",
        "todayStatus",
        "lastActionDate",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdherenceLog": {
      "title": "AdherenceLog",
      "description": "Immutable medication adherence action event (Taken, Snoozed, Skipped)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reminderId": { "type": "string" },
        "medicineName": { "type": "string" },
        "action": { "type": "string", "enum": ["TAKEN", "SNOOZED", "SKIPPED"] },
        "dateKey": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "reminderId", "medicineName", "action", "dateKey", "createdAt"]
    },
    "DoctorBrief": {
      "title": "DoctorBrief",
      "description": "Structured pre-consultation brief generated by AI Symptom Organizer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "language": { "type": "string", "enum": ["EN", "BN"] },
        "chiefSymptoms": { "type": "string" },
        "severityAndContext": { "type": "string" },
        "questionsForDoctor": { "type": "array" },
        "redFlagWarning": { "type": "string" },
        "urgentCareAdvised": { "type": "boolean" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "language",
        "chiefSymptoms",
        "severityAndContext",
        "questionsForDoctor",
        "redFlagWarning",
        "urgentCareAdvised",
        "createdAt"
      ]
    },
    "DietPlanRecord": {
      "title": "DietPlanRecord",
      "description": "Culturally authentic Bangladeshi local food meal plan generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "language": { "type": "string", "enum": ["EN", "BN"] },
        "age": { "type": "integer" },
        "conditions": { "type": "array" },
        "preference": { "type": "string" },
        "breakfastTitle": { "type": "string" },
        "breakfastPortion": { "type": "string" },
        "breakfastRationale": { "type": "string" },
        "lunchTitle": { "type": "string" },
        "lunchPortion": { "type": "string" },
        "lunchRationale": { "type": "string" },
        "snackTitle": { "type": "string" },
        "snackPortion": { "type": "string" },
        "snackRationale": { "type": "string" },
        "dinnerTitle": { "type": "string" },
        "dinnerPortion": { "type": "string" },
        "dinnerRationale": { "type": "string" },
        "foodsToPrioritize": { "type": "array" },
        "foodsToLimit": { "type": "array" },
        "hydrationTip": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "language",
        "age",
        "conditions",
        "preference",
        "breakfastTitle",
        "breakfastPortion",
        "breakfastRationale",
        "lunchTitle",
        "lunchPortion",
        "lunchRationale",
        "snackTitle",
        "snackPortion",
        "snackRationale",
        "dinnerTitle",
        "dinnerPortion",
        "dinnerRationale",
        "foodsToPrioritize",
        "foodsToLimit",
        "hydrationTip",
        "createdAt"
      ]
    },
    "MoodEntry": {
      "title": "MoodEntry",
      "description": "Mental wellness diary check-in with AI reflection and mood score",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "language": { "type": "string", "enum": ["EN", "BN"] },
        "selectedMood": { "type": "string", "enum": ["HAPPY", "CALM", "TIRED", "STRESSED", "SAD"] },
        "journalText": { "type": "string" },
        "detectedMoodTag": { "type": "string" },
        "moodScore": { "type": "integer" },
        "aiReflection": { "type": "string" },
        "microAction": { "type": "string" },
        "supportNote": { "type": "string" },
        "dateLabel": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "language",
        "selectedMood",
        "journalText",
        "detectedMoodTag",
        "moodScore",
        "aiReflection",
        "microAction",
        "supportNote",
        "dateLabel",
        "createdAt"
      ]
    },
    "MedicalReport": {
      "title": "MedicalReport",
      "description": "Serially indexed medical report saved to the user's cloud vault for viewing and AI Q&A",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serialNumber": { "type": "integer" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["LAB_TEST", "PRESCRIPTION", "IMAGING", "DOCTOR_NOTE", "OTHER"] },
        "doctorOrLab": { "type": "string" },
        "reportDate": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "attachmentType": { "type": "string", "enum": ["TEXT", "IMAGE", "FILE", "AUDIO"] },
        "attachmentName": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "serialNumber",
        "title",
        "category",
        "doctorOrLab",
        "reportDate",
        "summary",
        "details",
        "createdAt"
      ]
    },
    "DoctorAppointment": {
      "title": "DoctorAppointment",
      "description": "Paid online professional doctor consultation appointment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "specialty": { "type": "string" },
        "hospital": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "timeSlot": { "type": "string" },
        "consultationMode": { "type": "string", "enum": ["VIDEO", "AUDIO", "CHAT"] },
        "feeBdt": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["BKASH", "NAGAD", "CARD"] },
        "paymentStatus": { "type": "string", "enum": ["PAID", "REFUNDED"] },
        "bookingStatus": { "type": "string", "enum": ["CONFIRMED", "COMPLETED", "CANCELLED"] },
        "bookingRef": { "type": "string" },
        "reasonForVisit": { "type": "string" },
        "attachedReportTitle": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "doctorId",
        "doctorName",
        "specialty",
        "hospital",
        "appointmentDate",
        "timeSlot",
        "consultationMode",
        "feeBdt",
        "paymentMethod",
        "paymentStatus",
        "bookingStatus",
        "bookingRef",
        "reasonForVisit",
        "attachedReportTitle",
        "createdAt",
        "updatedAt"
      ]
    },
    "HealthMetricsRecord": {
      "title": "HealthMetricsRecord",
      "description": "Daily BMI calculation, hydration water intake tracker, and AI Life Condition Summary",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "bmiValue": { "type": "number" },
        "bmiCategory": { "type": "string" },
        "waterIntakeMl": { "type": "integer" },
        "waterGoalMl": { "type": "integer" },
        "lifeConditionTitle": { "type": "string" },
        "lifeConditionScore": { "type": "integer" },
        "lifeConditionSummary": { "type": "string" },
        "lifeConditionTips": { "type": "array" },
        "language": { "type": "string", "enum": ["EN", "BN"] },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "dateKey",
        "heightCm",
        "weightKg",
        "bmiValue",
        "bmiCategory",
        "waterIntakeMl",
        "waterGoalMl",
        "lifeConditionTitle",
        "lifeConditionScore",
        "lifeConditionSummary",
        "lifeConditionTips",
        "language",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile document"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/MedicineReminder" },
      "description": "User medicine reminders with custom clock and ringtone"
    },
    "/users/{userId}/adherence_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdherenceLog" },
      "description": "User medication adherence event logs"
    },
    "/users/{userId}/doctor_briefs/{briefId}": {
      "schema": { "$ref": "#/entities/DoctorBrief" },
      "description": "Saved pre-consultation doctor briefs"
    },
    "/users/{userId}/diet_plans/{planId}": {
      "schema": { "$ref": "#/entities/DietPlanRecord" },
      "description": "Saved local Bangladeshi food diet plans"
    },
    "/users/{userId}/mood_entries/{entryId}": {
      "schema": { "$ref": "#/entities/MoodEntry" },
      "description": "Mental wellness journal entries and mood scores"
    },
    "/users/{userId}/medical_reports/{reportId}": {
      "schema": { "$ref": "#/entities/MedicalReport" },
      "description": "Serially stored medical reports synced to user account"
    },
    "/users/{userId}/doctor_appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/DoctorAppointment" },
      "description": "Paid online professional doctor consultation appointments"
    },
    "/users/{userId}/health_metrics/{metricId}": {
      "schema": { "$ref": "#/entities/HealthMetricsRecord" },
      "description": "Daily BMI, hydration intake, and AI Life Condition Summary records"
    }
  }
}
